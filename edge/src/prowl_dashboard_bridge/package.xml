<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prowl_dashboard_bridge</name>
  <version>0.1.0</version>
  <description>Node.js (rclnodejs) bridge that serves Prowl's ROS2 topics to the dashboard over a WebSocket.</description>
  <maintainer email="weien.greathouse@gmail.com">Prowl Edge Team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Only for launch/test_page.launch.py. -->
  <exec_depend>prowl_ld19_driver</exec_depend>
  <exec_depend>prowl_motor_driver</exec_depend>

  <!-- Also needs Node.js >= 20.20.2 (in the dev image) and its npm packages, installed with `npm ci`
       in this folder (./prowl does that when they're missing). -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
