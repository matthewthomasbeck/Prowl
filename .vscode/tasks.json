{
  // Prowl tasks. Terminal > Run Task... then pick one.
  //   "Prowl: first-time setup"  installs the backend's Python packages and the dashboard's npm packages
  //   "Prowl: run everything"    starts the backend, the simulated rover and the dashboard, each in its own terminal
  // Pressing F5 (Run) also starts everything, then opens the dashboard.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prowl: first-time setup",
      "dependsOrder": "sequence",
      "dependsOn": ["Prowl: make backend venv", "Prowl: install backend packages", "Prowl: install dashboard packages"],
      "problemMatcher": []
    },
    {
      "label": "Prowl: make backend venv",
      "type": "shell",
      "command": "python -m venv .venv",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "osx": { "command": "python3 -m venv .venv" },
      "linux": { "command": "python3 -m venv .venv" },
      "problemMatcher": []
    },
    {
      "label": "Prowl: install backend packages",
      "type": "shell",
      "command": ".venv/bin/python -m pip install -r requirements.txt",
      "windows": { "command": ".venv\\Scripts\\python.exe -m pip install -r requirements.txt" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Prowl: install dashboard packages",
      "type": "shell",
      "command": "npm install",
      "windows": { "command": "npm.cmd install" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Prowl: run everything",
      "dependsOn": ["Prowl: backend", "Prowl: simulated rover", "Prowl: dashboard"],
      "problemMatcher": []
    },
    {
      "label": "Prowl: backend",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "prowl", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "prowl-backend",
        "pattern": { "regexp": "^__prowl_never__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "^__prowl_never__$",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Prowl: simulated rover",
      "type": "shell",
      "command": ".venv/bin/python -u tools/fake_robot.py --speed 2",
      "windows": { "command": ".venv\\Scripts\\python.exe -u tools\\fake_robot.py --speed 2" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "prowl", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "prowl-rover",
        "pattern": { "regexp": "^__prowl_never__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "^__prowl_never__$",
          "endsPattern": "(started|resumed) session|cannot connect"
        }
      }
    },
    {
      "label": "Prowl: dashboard",
      "type": "shell",
      "command": "npm run dev",
      "windows": { "command": "npm.cmd run dev" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "prowl", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "prowl-dashboard",
        "pattern": { "regexp": "^__prowl_never__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "^__prowl_never__$",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
